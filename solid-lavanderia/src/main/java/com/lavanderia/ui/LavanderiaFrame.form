<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.lavanderia.ui.LavanderiaFrame">
  <grid id="root" binding="contentPane" layout-manager="GridLayoutManager" row-count="10" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="560" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lbl1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ID Cliente:"/>
        </properties>
      </component>
      <component id="txtId" class="javax.swing.JTextField" binding="txtClienteId">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="lbl2" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Nombre:"/>
        </properties>
      </component>
      <component id="txtNombre" class="javax.swing.JTextField" binding="txtClienteNombre">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="lbl3" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Email:"/>
        </properties>
      </component>
      <component id="txtEmail" class="javax.swing.JTextField" binding="txtClienteEmail">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="chkBasico" class="javax.swing.JCheckBox" binding="chkLavadoBasico">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Lavado básico ($200.00)"/>
        </properties>
      </component>
      <component id="chkSeco" class="javax.swing.JCheckBox" binding="chkLavadoSeco">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Lavado en seco ($500.00)"/>
        </properties>
      </component>
      <component id="chkPlanchado" class="javax.swing.JCheckBox" binding="chkPlanchado">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Planchado ($150.00)"/>
        </properties>
      </component>
      <component id="lbl4" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Total estimado:"/>
        </properties>
      </component>
      <component id="lblTotal" class="javax.swing.JLabel" binding="lblTotal">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="$0.00"/>
        </properties>
      </component>
      <component id="btnRegistrar" class="javax.swing.JButton" binding="btnRegistrar">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Registrar pedido"/>
        </properties>
      </component>
      <component id="btnRefrescar" class="javax.swing.JButton" binding="btnRefrescar">
        <constraints>
          <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Refrescar lista"/>
        </properties>
      </component>
      <scrollpane id="scrollTabla">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="150"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tablaPedidos" class="javax.swing.JTable" binding="tablaPedidos">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <scrollpane id="scrollLog">
        <constraints>
          <grid row="9" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="80"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="txtLog" class="javax.swing.JTextArea" binding="txtLog">
            <constraints/>
            <properties>
              <editable value="false"/>
              <rows value="4"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
